# 1. Analysis Point (Pick a yield where the option is 'active', e.g., 5%.)
# Now check at 2.5% where the option is deep in the money and 8% where the option is deep out of the money)

y_target = 0.05
p_target, slope, curvature = b_calc.calculate_callable_derivatives(y_target, face_v, coupon, years, num_periods, strike_price)

# 2. Generate Approximations
tangent_prices = b_calc.draw_tangent_line(ytm, y_target, p_target, slope)
quadratic_approx = b_calc.draw_convex_line(ytm, y_target, p_target, slope, curvature)

# 3. Plotting
plt.plot(ytm, callable_prices, color='black', lw=3, label='Actual Price (Ground Truth)')
plt.plot(ytm, tangent_prices, '--', label='Duration Tangent (Linear)', color='orange')
plt.plot(ytm, quadratic_approx, color='dodgerblue', linestyle=':', lw=2.5, label='2nd Order: Convexity (Quadratic)')
plt.scatter([y_target], [p_target], color='red', label=f'Analysis Point ({y_target*100}%)')

plt.title(f"Callable Bond: Tangent and Curvature at {y_target * 100}% Yield")
plt.ylim(0, 150)
plt.legend()
plt.grid(alpha=0.3)
plt.show()















