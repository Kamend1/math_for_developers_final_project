# 1. Calculate the 'Truth' (The full curve)
true_prices = b_calc.calculate_bond_price(ytm, face_v, coupon, years, num_periods)

# 2. Pick a point to analyze (e.g., Market Yield = 8%)
y_target = 0.08
p_target, slope, curvature = b_calc.calculate_derivatives(y_target, face_v, coupon, years, num_periods)

# 3. Generate the Tangent Line
tangent_prices = b_calc.draw_tangent_line(ytm, y_target, p_target, slope)

# Generate the Convex Line
quadratic_approx = b_calc.draw_convex_line(ytm, y_target, p_target, slope, curvature)

# 4. Plot the price function and the tangent line
plt.plot(ytm, true_prices, label='True Bond Price (Convex)', color='navy', lw=2)
plt.plot(ytm, tangent_prices, '--', label='Duration Tangent (Linear)', color='orange')
plt.scatter([y_target], [p_target], color='red', label=f'Analysis Point ({y_target*100}%)')

plt.title("The First Derivative: Duration as a Tangent Line")
plt.xlabel("Yield to Maturity")
plt.ylabel("Price")
plt.ylim(0, 150)
plt.legend()
plt.grid(alpha=0.3)
plt.show()





# 1. Plot the price function
plt.plot(ytm, true_prices, color='black', lw=3, label='Actual Price (Ground Truth)')

# 2. Generate the Tangent Line
plt.plot(ytm, tangent_prices, '--', label='Duration Tangent (Linear)', color='orange')

# 3. Generate the Convex Line
plt.plot(ytm, quadratic_approx, color='dodgerblue', linestyle=':', lw=2.5, label='2nd Order: Convexity (Quadratic)')

# Plot the Tangent Point
plt.scatter([y_target], [p_target], color='red', label=f'Analysis Point ({y_target*100}%)')

plt.title("Total Integration: The Taylor Series of Bond Pricing", fontsize=14)
plt.xlabel("Yield to Maturity (YTM)")
plt.ylabel("Bond Price")
plt.ylim(0, 150)
plt.legend()
plt.grid(alpha=0.3)
plt.show()





