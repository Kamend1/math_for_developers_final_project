import numpy as np
import matplotlib.pyplot as plt


# import your modules here





def calculate_bond_price(yield_to_maturity, face_value, coupon_rate, years, num_periods_year):
    """
    Calculates a single bond price for a given yield with semiannual compounding.
    """
    periods = int(years * num_periods_year)
    semi_coupon = (face_value * coupon_rate) / num_periods_year
    semi_yield = yield_to_maturity / num_periods_year
    t = np.arange(1, periods + 1).reshape(-1, 1)
    
    pv_coupons = np.sum(semi_coupon / (1 + semi_yield)**t, axis=0)
    pv_face = face_value / (1 + semi_yield)**periods

    price = pv_coupons + pv_face
    
    return price


face_v = 100
coupon = 0.05
years = 10
num_periods = 2

ytm = np.linspace(0, 0.2, 10000)
price = calculate_bond_price(ytm, face_v, coupon, years, num_periods)

price


plt.plot(ytm, price)
plt.show()


def calculate_derivatives(y0, face_v, coupon, years, num_periods):
    """
    Calculates the 1st and 2nd derivatives of the bond price function at y0.
    """
    h = 0.0001  # An infinitesimal change in yield
    
    # Calculate price at three points
    p_center = calculate_bond_price(y0, face_v, coupon, years, num_periods)
    p_plus = calculate_bond_price(y0 + h, face_v, coupon, years, num_periods)
    p_minus = calculate_bond_price(y0 - h, face_v, coupon, years, num_periods)
    
    # First Derivative (Slope / Dollar Duration)
    # f'(x) ≈ [f(x+h) - f(x-h)] / 2h
    d1 = (p_plus - p_minus) / (2 * h)
    
    # Second Derivative (Curvature / Dollar Convexity)
    # f''(x) ≈ [f(x+h) - 2f(x) + f(x-h)] / h^2
    d2 = (p_plus - 2 * p_center + p_minus) / (h**2)
    
    return p_center, d1, d2

def draw_tangent_line(ytm_range, y0, p0, d1):
    """
    Calculates the Y-values for a tangent line at point (y0, p0).
    """
    # Linear approximation: P = P0 + slope * change_in_yield
    return p0 + d1 * (ytm_range - y0)


# Setup
face_v = 100
coupon = 0.05
years = 10
num_periods = 2
# ytm_range = np.linspace(0.01, 0.20, 100)

# 1. Calculate the 'Truth' (The full curve)
true_prices = calculate_bond_price(ytm, face_v, coupon, years, num_periods)

# 2. Pick a point to analyze (e.g., Market Yield = 8%)
y_target = 0.08
p_target, slope, curvature = calculate_derivatives(y_target, face_v, coupon, years, num_periods)

# 3. Generate the Tangent Line
tangent_prices = draw_tangent_line(ytm, y_target, p_target, slope)

# Quadratic (Convexity) - P = P0 + P'dy + 0.5 * P''dy^2
dy = ytm - y_target
quadratic_approx = p_target + (d1 * dy) + (0.5 * d2 * dy**2)

# 4. Plot
# plt.figure(figsize=(10, 6))
plt.plot(ytm, true_prices, label='True Bond Price (Convex)', color='navy', lw=2)
plt.plot(ytm, tangent_prices, '--', label='Duration Tangent (Linear)', color='orange')
plt.scatter([y_target], [p_target], color='red', label=f'Analysis Point ({y_target*100}%)')

plt.title("The First Derivative: Duration as a Tangent Line")
plt.xlabel("Yield to Maturity")
plt.ylabel("Price")
plt.ylim(0, 150)
plt.legend()
plt.grid(alpha=0.2)
plt.show()


# --- 3. The Integrated Plot ---
plt.figure(figsize=(12, 7))

# Actual Data
plt.plot(ytm, price, color='black', lw=3, label='Actual Price (Ground Truth)')

# Taylor Series Layer 1: The Tangent
plt.plot(ytm, tangent_prices, color='crimson', linestyle='--', label='1st Order: Duration (Linear)')

# Taylor Series Layer 2: The Curve
plt.plot(ytm, quadratic_approx, color='dodgerblue', linestyle=':', lw=2.5, label='2nd Order: Convexity (Quadratic)')

# Highlight the Tangent Point
plt.scatter([y_target], [p_target], color='gold', s=100, edgecolor='black', zorder=5, label=f'Yield Target ({y_target*100}%)')

# Plot Aesthetics
plt.title("Total Integration: The Taylor Series of Bond Pricing", fontsize=14)
plt.xlabel("Yield to Maturity (YTM)")
plt.ylabel("Bond Price")
plt.ylim(min(price)-10, max(price)+10) # Keep focus on the data
plt.legend()
plt.grid(alpha=0.3)
plt.show()



