# Import your modules here

from src.mathematical_calculations_utils import option_calc_utils as o_calc
from src.mathematical_calculations_utils import bond_calc_utils as b_calc











# 1. Define Portfolio Parameters
current_value = 1000000  # $1M Portfolio
strike = current_value * 0.95  # 5% Downside protection (95% floor)
time_to_maturity = 1  # 1 year
rf_rate = 0.03  # 3% risk-free rate

optimal_variance =  0.0499 # Take the value from the calculated respective result in notebook 1_3
portfolio_vol = np.sqrt(optimal_variance)





insurance_cost = o_calc.black_scholes(
    S=current_value, 
    K=strike, 
    T=time_to_maturity, 
    r=rf_rate, 
    sigma=portfolio_vol, 
    option_type='put'
)

print(insurance_cost)








current_value_range = np.linspace(500000, 1500000, 100000)
insurance_cost_range =o_calc.black_scholes(
    S=current_value_range, 
    K=strike, 
    T=time_to_maturity, 
    r=rf_rate, 
    sigma=portfolio_vol, 
    option_type='put'
)
payoff = np.maximum(strike - current_value_range, 0)
print(insurance_cost_range)


plt.plot(current_value_range, insurance_cost_range, label='Portfolio Put Option Prie', color='navy', lw=2)
plt.plot(current_value_range, payoff, linestyle=':', label='Put Payoff at Expiry')
plt.axvline(strike, color='red', linestyle='--', label='Strike Price')
plt.xlabel('Current Portfolio Value')
plt.ylabel('Put Option Value/Cost to Insure the Portfolio at $950,000')
plt.title("Portfolio Put Option Price Function")
plt.legend()
plt.grid(alpha=0.3)
plt.show()





current_value_target = 1000000
put_price_target, slope, curvature = o_calc.calculate_option_derivatives_1(current_value_target, 
                                                                         K=strike, 
                                                                         T=time_to_maturity, 
                                                                         r=rf_rate, 
                                                                         sigma=portfolio_vol, 
                                                                         option_type='put',
                                                                     )
print(f"Put price: {put_price_target:.2f}")
print(f"Delta (slope): {slope:.4f}")
print(f"Gamma (curvature): {curvature}")


tangent_line = b_calc.draw_tangent_line(current_value_range, current_value_target, put_price_target, slope)
quadratic_approx = b_calc.draw_convex_line(current_value_range, current_value_target, put_price_target, slope, curvature)





plt.plot(current_value_range, insurance_cost_range, label='Portfolio Put Option Prie', color='navy', lw=2)
plt.plot(current_value_range, payoff, linestyle=':', label='Put Payoff at Expiry')
plt.plot(current_value_range, tangent_line, '--', label='Delta Put Option - Price Sensitivity', color='orange')
plt.plot(current_value_range, quadratic_approx, color='dodgerblue', linestyle=':', lw=2.5, label='2nd Order Gama: Convexity (Quadratic)')
plt.axvline(strike, color='red', linestyle='--', label='Strike Price')
plt.scatter([current_value], [put_price_target], color='red', label=f'Analysis Point ({insurance_cost:.2f})')
plt.xlabel('Current Portfolio Value')
plt.ylabel('Put Option Value/Cost to Insure the Portfolio at $950,000')
plt.title("Portfolio Put Option Price Function")
plt.legend()
plt.grid(alpha=0.3)
plt.show()






